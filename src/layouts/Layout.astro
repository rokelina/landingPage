---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "A showcase of my latest projects and professional portfolio." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body>
		<!-- Ambient Background -->
		<div class="bg-blob blob-1"></div>
		<div class="bg-blob blob-2"></div>
		
		<slot />
	</body>
</html>
